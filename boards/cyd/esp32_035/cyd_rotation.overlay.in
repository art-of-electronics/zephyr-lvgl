#define CYD_LCD_ROTATION @CYD_LCD_ROTATION@

&lcd {

#if CYD_LCD_ROTATION == 0
    width = <320>;
    height = <480>;
    madctl = <0x48>;

#elif CYD_LCD_ROTATION == 90
    width = <480>;
    height = <320>;
    madctl = <0x28>;

#elif CYD_LCD_ROTATION == 180
    width = <320>;
    height = <480>;
    madctl = <0x88>;

#elif CYD_LCD_ROTATION == 270
    width = <480>;
    height = <320>;
    madctl = <0xE8>;

#else

#error Unsupported CYD_LCD_ROTATION

#endif
};

&touchscreen {

    /*
     * Keep the calibrated portrait coordinate space.
     */
    touchscreen-size-x = <320>;
    touchscreen-size-y = <480>;

    screen-width = <320>;
    screen-height = <480>;

    /*
     * Clear transformations from the base DTS.
     */
    /delete-property/ swapped-x-y;
    /delete-property/ inverted-x;
    /delete-property/ inverted-y;

#if CYD_LCD_ROTATION == 0
    inverted-x;
    inverted-y;

#elif CYD_LCD_ROTATION == 90
    swapped-x-y;
    inverted-y;

#elif CYD_LCD_ROTATION == 180
    /* No inversion required. */

#elif CYD_LCD_ROTATION == 270
    swapped-x-y;
    inverted-x;

#endif
};
