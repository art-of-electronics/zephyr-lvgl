/dts-v1/;

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <espressif/esp32s3/esp32s3_wroom_n16r8.dtsi>
#include <espressif/partitions_0x0_amp_16M.dtsi>
#include "uedx48270043e_wb_a-pinctrl.dtsi"

/ {
	model = "VIEWE UEDX48270043E-WB-A PROCPU";
	compatible = "viewe,uedx48270043e_wb_a", "espressif,esp32s3";

	chosen {
	    zephyr,sram = &sram1;
	    zephyr,console = &uart0;
	    zephyr,shell-uart = &uart0;
	    zephyr,flash = &flash0;
	    zephyr,code-partition = &slot0_partition;
	    zephyr,bt-hci = &esp32_bt_hci;
	    zephyr,touch = &gt911;
		zephyr,display = &lcd_rgb;
    };

	aliases {
		sw0 = &button;
		watchdog0 = &wdt0;
		sdhc0 = &sd0;
		backlight-pwm = &lcd_backlight;
		led-strip = &rgb_led;
	};

	keys: keys {
		compatible = "gpio-keys";
		debounce-interval-ms = <10>;

		button: button {
			gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	lcd_backlight: lcd-backlight {
    	compatible = "pwm-leds";
    	backlight {
        	pwms = <&ledc0 0 PWM_HZ(250) PWM_POLARITY_NORMAL>;
		};
    };

	rgb_led: ws2812 {
		compatible = "worldsemi,ws2812-pulse-io";
		pulse-ios = <&rmt 0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};
};

&dma {
	status = "okay";
};

&timer0 {
	status = "disabled";
};

&timer1 {
	status = "disabled";
};

&timer2 {
	status = "disabled";
};

&timer3 {
	status = "disabled";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-names = "default";

    gt911: gt911@5d {
        compatible = "goodix,gt911";
        reg = <0x5d>;
        alt-addr = <0x14>;

        irq-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
        /*reset-gpios = <&gpio0 38 GPIO_ACTIVE_LOW>;*/

        status = "okay";
    };
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	clock-frequency = <20000000>;
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;

	sd0: sd@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <20000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&lcd_cam {
    status = "okay";
    pinctrl-0 = <&lcd_cam_rgb_default>;
    pinctrl-names = "default";

    lcd_rgb: display {
        compatible = "espressif,esp32-lcd-cam-rgb";
        status = "okay";

        width = <480>;
        height = <272>;

        display-timings {
            compatible = "zephyr,panel-timing";

            clock-frequency = <16000000>;

            hsync-len = <1>;
            hback-porch = <42>;
            hfront-porch = <20>;

            vsync-len = <10>;
            vback-porch = <12>;
            vfront-porch = <4>;

            hsync-active = <0>;
            vsync-active = <0>;
            de-active = <1>;
            pixelclk-active = <0>;
        };
    };
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};

&usb_serial {
	status = "okay";
};

zephyr_udc0: &usb_otg {
	status = "okay";
};

&ledc0 {
    status = "okay";
    pinctrl-0 = <&backlight_pwm_default>;
    pinctrl-names = "default";
    #address-cells = <1>;
    #size-cells = <0>;
    channel0@0 {
        reg = <0>;
        timer = <0>;
    };
};

&rmt {
	pinctrl-0 = <&rmt_ws2812>;
	pinctrl-names = "default";
	status = "okay";
};
